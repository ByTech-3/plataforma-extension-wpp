# ============================================================================
#  extension — variáveis de ambiente
#
#  Copie este arquivo para `.env` e preencha com os valores do projeto Supabase
#  (Dashboard > Project Settings > API). É o MESMO projeto usado pelo app web.
#
#  O prefixo WXT_ é obrigatório: sem ele o WXT não expõe a variável ao código
#  da extensão.
#
#  `.env` está no .gitignore e nunca deve ser commitado.
# ============================================================================

# URL do projeto Supabase. Ex.: https://xxxxxxxxxxxx.supabase.co
WXT_SUPABASE_URL=

# Chave `anon` (pública). Segura no cliente porque a RLS da Fase 2 está ativa —
# sozinha, ela não dá acesso a dado nenhum.
WXT_SUPABASE_ANON_KEY=

# ⚠️ A chave `service_role` NUNCA entra aqui. Ela ignora toda a RLS, e uma
#    extensão de navegador é código que roda na máquina do cliente: qualquer
#    pessoa consegue lê-la.

# URL do app web — de onde a extensão lê a sessão do vendedor.
#
# Opcional: sem ela, vale a produção (https://plataforma-web-wpp.vercel.app).
# Para testar contra o app rodando na sua máquina, use http://localhost:3000 —
# esse endereço já está declarado em `host_permissions` no wxt.config.ts, e sem
# a permissão de host o navegador recusa a leitura do cookie.
WXT_APP_URL=
